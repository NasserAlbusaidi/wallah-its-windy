{
  "name": "cyclone-sim",
  "version": "0.1.0",
  "description": "Wallah It's Windy — Arabian Sea cyclone sandbox. Spawn a storm, let it take course.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "calibrate:check": "node --experimental-strip-types calibration/run.mjs --check && node --experimental-strip-types calibration/hindcast.mjs --check && node --experimental-strip-types calibration/fidelity.mjs --check",
    "calibrate:intensity": "node --experimental-strip-types calibration/hindcast.mjs",
    "calibrate:intensity:check": "node --experimental-strip-types calibration/hindcast.mjs --check",
    "calibrate:structure": "node --experimental-strip-types calibration/run.mjs",
    "calibrate:demo": "node --experimental-strip-types calibration/select-demo.mjs",
    "assets:manifest": "node calibration/asset-manifest.mjs --write",
    "assets:check": "node calibration/asset-manifest.mjs",
    "data:fidelity:catalog": "node bake/run-python.mjs bake/fidelity_catalog.py",
    "data:fidelity:fetch": "node bake/run-python.mjs -u bake/fetch_fidelity_benchmark.py",
    "data:fidelity:bake": "node bake/run-python.mjs bake/bake_fidelity_benchmark.py",
    "data:hf2a:ocean": "node bake/run-python.mjs -u bake/hf2a_ocean_benchmark.py",
    "data:hf2a:ocean:check": "node bake/run-python.mjs bake/hf2a_ocean_benchmark.py --check",
    "data:hf2a:profiles": "node bake/run-python.mjs -u bake/bake_ocean_profiles.py",
    "data:hf2:initial-structure": "node bake/run-python.mjs bake/bake_hf2_initial_structure.py",
    "data:hf3:steering": "node bake/run-python.mjs bake/bake_hf3_steering.py",
    "data:structure": "python3 bake/extract_structure_validation.py",
    "live:acquire": "node bake/run-python.mjs -u bake/public_cycle.py",
    "fidelity": "node --experimental-strip-types calibration/fidelity.mjs",
    "fidelity:development": "node --experimental-strip-types calibration/fidelity.mjs --partition=development",
    "fidelity:check": "node --experimental-strip-types calibration/fidelity.mjs --check",
    "hf2a:contract:check": "vitest run test/hf2a-contract.test.ts",
    "hf2a:ocean:reference": "node --experimental-strip-types calibration/hf2a-ocean-reference.mjs",
    "hf2a:ocean:reference:check": "node --experimental-strip-types calibration/hf2a-ocean-reference.mjs --check",
    "hf2a:ocean:candidate": "node --experimental-strip-types calibration/hf2a-ocean-reference.mjs --candidate",
    "hf2a:ocean:candidate:check": "node --experimental-strip-types calibration/hf2a-ocean-reference.mjs --candidate --check",
    "hf2a:ocean:gate": "node calibration/hf2a-ocean-gate.mjs --enforce",
    "hf2a:ocean:gate:check": "node calibration/hf2a-ocean-gate.mjs --check",
    "hf2a:ocean:gate:require-accepted": "node calibration/hf2a-ocean-gate.mjs --check --enforce",
    "hf2:gate": "node calibration/hf2-gate.mjs",
    "hf2:gate:check": "node calibration/hf2-gate.mjs --check",
    "hf2:gate:require-accepted": "node calibration/hf2-gate.mjs --check --require-accepted",
    "hf3:wander": "node calibration/hf3-wander-calibration.mjs",
    "hf3:wander:check": "node calibration/hf3-wander-calibration.mjs --check",
    "hf3:gate": "node calibration/hf3-gate.mjs",
    "hf3:gate:check": "node calibration/hf3-gate.mjs --check",
    "hf3:gate:require-accepted": "node calibration/hf3-gate.mjs --check --require-accepted",
    "hf4:verify": "node calibration/hf4-verify.mjs",
    "hf4:verify:check": "node calibration/hf4-verify.mjs --check",
    "hf4:gate": "node calibration/hf4-gate.mjs",
    "hf4:gate:check": "node calibration/hf4-gate.mjs --check",
    "hf4:gate:require-accepted": "node calibration/hf4-gate.mjs --check --require-accepted",
    "hf5:archive:sample": "node --experimental-strip-types bake/live_archive.mjs --input=calibration/data/hf5/sample-live-run.json --archive-root=tmp/hf5-archive",
    "hf5:gate": "node calibration/hf5-gate.mjs",
    "hf5:gate:check": "node calibration/hf5-gate.mjs --check --require-complete",
    "data:hf6:catalog": "node bake/run-python.mjs bake/hf6_catalog.py",
    "data:hf6:catalog:check": "node bake/run-python.mjs bake/hf6_catalog.py --check",
    "data:hf6:fetch": "node bake/run-python.mjs -u bake/fetch_hf6_benchmark.py",
    "data:realism:fetch": "node bake/run-python.mjs -u bake/fetch_realism_era5.py",
    "data:realism:variance": "node bake/run-python.mjs bake/realism_env_variance.py",
    "data:upper": "node bake/run-python.mjs bake/bake_upper_winds.py",
    "data:upper:check": "node bake/run-python.mjs bake/bake_upper_winds.py --check",
    "hf6:observation-audit": "node bake/run-python.mjs bake/hf6_observation_audit.py",
    "data:hf6:bake": "node bake/run-python.mjs bake/bake_hf6_benchmark.py",
    "hf6:verify": "node calibration/hf6-verify.mjs",
    "hf6:verify:check": "node calibration/hf6-verify.mjs --check",
    "hf6:prospective:check": "node --experimental-strip-types bake/hf6_prospective.mjs",
    "hf6:gate": "node calibration/hf6-gate.mjs",
    "hf6:gate:check": "node calibration/hf6-gate.mjs --check --require-implementation-complete",
    "profile:ensemble": "vitest bench --run calibration/ensemble.bench.ts",
    "realism": "node --experimental-strip-types calibration/realism/realism.mjs",
    "realism:check": "node --experimental-strip-types calibration/realism/realism.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
